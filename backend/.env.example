# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/marcomms_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_here
SUBSCRIPTION_CREDENTIAL_KEY=base64_encoded_32_byte_key
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5001
NODE_ENV=development

# Private asset storage (Supabase bucket must remain private)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=marcomms-assets

# Optional legacy AWS configuration (only if Lambda/SES/backups remain enabled)
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Email Sender
REMINDER_FROM_EMAIL=kyawzin.soe@kbzbank.com
RESEND_API_KEY=your_resend_api_key_optional
