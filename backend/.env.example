# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/marcomms_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_here
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5001
NODE_ENV=development

# AWS Configuration (Lambda / S3 / SES)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-s3-backup-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Email Sender
REMINDER_FROM_EMAIL=no-reply@marcomms.kbzpay.com
RESEND_API_KEY=your_resend_api_key_optional
